{
  "name": "guidehollow-genre-sites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && astro dev --host 0.0.0.0",
